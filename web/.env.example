NEXT_PUBLIC_API_URL=http://localhost:8000

# 地図タイル。未設定の場合は地図にタイルを表示しない（外部へ要求も送らない）。
# セルフホスト推奨: 自前タイルサーバ（tileserver-gl 等）の URL を指定する。
# 開発時は dev に CSP が無いため tileserver へ直接指してよい:
# NEXT_PUBLIC_MAP_TILE_URL=http://localhost:8081/styles/basic/{z}/{x}/{y}.png
# 本番（Caddy 経由）は同一オリジン配信を使う（deploy/env.example 参照）:
# NEXT_PUBLIC_MAP_TILE_URL=/tiles/styles/basic/{z}/{x}/{y}.png
# あえて公開 OSM を使う場合（＝外部送信が発生する点に注意）:
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
