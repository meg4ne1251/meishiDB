APP_ENV=development
SECRET_KEY=change-me-please-use-a-long-random-string
DATABASE_URL=postgresql+asyncpg://meishi:meishi@localhost:5432/meishi
SESSION_COOKIE_NAME=meishi_session
SESSION_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000

# OCR / search / storage
OCR_SERVICE_URL=http://ocr:8000

# 住所ジオコーディング（自前 Nominatim 等）。空なら地図は座標を持つ名刺のみ表示。
# docker compose の geocoder プロファイルを使う場合: http://geocoder:8080
GEOCODER_URL=
MEILISEARCH_URL=http://search:7700
MEILISEARCH_KEY=meili-master-key-change-me
MINIO_ENDPOINT=http://storage:9000
MINIO_ACCESS_KEY=meishi
MINIO_SECRET_KEY=meishi-storage-secret
MINIO_BUCKET_ORIGINAL=cards-original
MINIO_BUCKET_THUMB=cards-thumb

# WebAuthn / Passkey
# 本番ではドメイン (example.com) を rp_id に指定し、origin は https:// 始まりにする
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=meishiDB
WEBAUTHN_ORIGIN=http://localhost:3000

# scanner-watcher 連携
SCANNER_API_TOKEN=
SCANNER_OWNER_EMAIL=
