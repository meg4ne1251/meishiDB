# API
# development はローカルHTTP用。本番は production.yml が production に固定する。
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
# 更新要求の送信元検証にも使用。VPN経由の場合はブラウザで開くWeb URLを指定する。
SECRET_KEY=change-me-to-a-long-random-string

# MinIO（オブジェクトストレージ）
MINIO_ROOT_USER=meishi
MINIO_ROOT_PASSWORD=meishi-storage-secret

# Meilisearch
MEILI_MASTER_KEY=meili-master-key-change-me

# Scanner watcher（任意・利用しない場合は空でOK）
SCANNER_API_TOKEN=
SCANNER_OWNER_EMAIL=

# 住所ジオコーディング（任意）。`--profile geocoder` で Nominatim を起動する場合に設定。
# 例: GEOCODER_URL=http://geocoder:8080
GEOCODER_URL=

# 地図タイル。未設定なら地図はタイルを表示しない（外部送信ゼロが既定）。
# セルフホスト推奨: `--profile tileserver` で tileserver-gl を建て、Caddy 経由で
# 同一オリジン配信する（CSP の 'self' を満たし、外部送信ゼロを保てる）:
#   NEXT_PUBLIC_MAP_TILE_URL=/tiles/styles/basic/{z}/{x}/{y}.png
# あえて公開 OSM を使う場合（外部送信が発生＋Caddyfile の CSP に当該ホストの追記が必要）:
#   NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_URL=

# Caddy / 公開ホスト名（VPN 内ホスト名でも OK）
PUBLIC_HOST=meishi.local
